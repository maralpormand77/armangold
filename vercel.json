{
  "version": 2,
  "cleanUrls": true,
  "framework": null,
  "crons": [
    {
      "path": "/api/cron-update",
      "schedule": "*/30 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
