# ==============================================================================
# تنظیمات اتصال به پایگاه‌داده PostgreSQL جهت تحلیل داده‌های لحظه‌ای طلا و سکه
# ==============================================================================

# روش اول: استفاده از آدرس اتصال مستقیم (Connection String / DSN)
# مناسب برای هاست‌های ابری رایگان مثل Neon.tech, Supabase, Render, Railway:
# DATABASE_URL=postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/gold_db?sslmode=require

# روش دوم: تنظیم پارامترهای مجزا (مناسب برای PostgreSQL محلی یا سرور شخصی):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gold_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# نکته:
# ۱. این فایل را کپی کرده و به نام .env در همین پوشه ذخیره کنید.
# ۲. مقادیر بالا را با مشخصات دیتابیس خود جایگزین کنید.
# ۳. در صورت فعال بودن PostgreSQL، تمام استعلام‌های ۳۰ دقیقه‌ای مستقیماً در جداول
#    و نماهای تحلیلی (OHLC ساعتی، روزانه و حباب سکه) ثبت می‌شوند.
# ۴. برای تحلیل خودکار داده‌ها کافیست دستور python analyze_postgres.py را اجرا کنید.
