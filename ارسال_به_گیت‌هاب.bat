@echo off
chcp 65001 > nul
title اتصال و ارسال پروژه به گیت‌هاب (Push to GitHub)
color 0B

echo =========================================================================
echo          🚀 ارسال خودکار تغییرات پروژه به گیت‌هاب: maralpormand77/armangold
echo =========================================================================
echo.
echo ریپازیتوری شما متصل است به:
echo https://github.com/maralpormand77/armangold.git
echo.

:: گام ۱: ذخیره و کامیت خودکار تغییرات محلی در صورت وجود
git add -A
git diff --quiet --cached
if %errorlevel% neq 0 (
    echo [۱/۳] در حال ثبت تغییرات جدید در گیت محلی...
    git commit -m "بروزرسانی زنده نرخ طلا و مسکوکات"
) else (
    echo [۱/۳] تمام فایل‌ها قبلاً ثبت شده‌اند.
)

:: گام ۲: همگام‌سازی با آخرین نسخه گیت‌هاب قبل از ارسال
echo [۲/۳] در حال بررسی و همگام‌سازی با سرور گیت‌هاب...
git fetch origin main > nul 2>&1
git merge -s ours origin/main -m "همگام‌سازی خودکار شاخه اصلی" > nul 2>&1

:: گام ۳: ارسال تغییرات
echo [۳/۳] در حال ارسال داده‌ها به سرور گیت‌هاب...
echo.
set /p TOKEN="اگر توکن شخصی گیت‌هاب دارید وارد کنید (یا بدون وارد کردن اینتر بزنید): "

if not "%TOKEN%"=="" (
    echo در حال ارسال با توکن احراز هویت...
    git push -u https://%TOKEN%@github.com/maralpormand77/armangold.git main
) else (
    echo در حال ارسال با تنظیمات پیش‌فرض گیت...
    git push -u origin main
)

if %errorlevel% equ 0 (
    echo.
    echo =========================================================================
    echo ✅ تغییرات با موفقیت به گیت‌هاب ارسال شد!
    echo نمایش زنده سایت (GitHub Pages و Vercel) به‌روزرسانی گردید.
    echo =========================================================================
) else (
    echo.
    echo =========================================================================
    echo ⚠️ ارسال با خطا مواجه شد. لطفاً اتصال اینترنت یا توکن گیت‌هاب را بررسی فرمایید.
    echo =========================================================================
)
pause
